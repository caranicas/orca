{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  // The bridge reuses the CLI's runtime client, so its graph reaches into src/cli and src/shared.
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "module": "Node20",
    "moduleResolution": "Node16",
    "rootDir": "../..",
    "noEmit": true,
    "types": ["node"]
  }
}
